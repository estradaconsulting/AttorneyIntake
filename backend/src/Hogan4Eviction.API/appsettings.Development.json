{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Database": {
    "AutoMigrate": true
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "./uploads"
  },
  "Security": {
    "SwaggerEnabled": true,
    "DevAuthEnabled": true
  }
}
