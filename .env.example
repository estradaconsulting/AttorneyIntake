# Copy this file to .env and fill in values before running docker-compose
# Never commit .env to source control

# ── Local Dev ─────────────────────────────────────────────────────────────────
DB_SA_PASSWORD=Dev@Password123

# ── Azure SQL (production / staging) ─────────────────────────────────────────
# AZURE_SQL_CONNECTION_STRING=Server=tcp:<server>.database.windows.net,1433;...

# ── Azure Blob Storage (document uploads) ────────────────────────────────────
# AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
# AZURE_BLOB_CONTAINER_NAME=case-documents

# ── Azure AD / Entra ID (future auth) ────────────────────────────────────────
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=

# ── Azure Key Vault ───────────────────────────────────────────────────────────
# AZURE_KEY_VAULT_URI=https://<vault-name>.vault.azure.net/

# ── Email (notifications) ─────────────────────────────────────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=Hogan4eviction@outlook.com
# SMTP_PASSWORD=

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
