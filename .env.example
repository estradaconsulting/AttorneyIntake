# Copy this file to .env and fill in all values before running docker-compose.
# NEVER commit .env to source control — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# H-02: No defaults. Generate strong, unique passwords before first run.
DB_SA_PASSWORD=           # SQL Server SA password — strong, unique, never reused

# H-07: Create a least-privilege app account (db_datareader + db_datawriter only).
# See docs/db-setup.sql for the CREATE LOGIN / CREATE USER script.
DB_APP_USER=hogan_app
DB_APP_PASSWORD=          # Strong password for the app account

# M-06: Set to False in staging/production. True only acceptable for local dev
#       with a self-signed cert and no network exposure.
DB_TRUST_CERT=False

# ── Auth ──────────────────────────────────────────────────────────────────────
# C-01: Set DevAuthEnabled=true ONLY during local development.
#       MUST be false in staging and production.
DEV_AUTH_ENABLED=false

# Azure AD / Entra ID (production auth)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_AUDIENCE=

# Symmetric JWT (alternative for non-Azure deployments — min 32 chars)
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# ── Azure Blob Storage (document uploads) ─────────────────────────────────────
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=case-documents

# ── Azure Key Vault ───────────────────────────────────────────────────────────
AZURE_KEY_VAULT_URI=

# ── Swagger (M-08) ────────────────────────────────────────────────────────────
# Enable in dev only. Must be false in production.
SWAGGER_ENABLED=false

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
